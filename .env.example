# ==================== 串口配置 ====================
SERIAL_PORT=COM3
BT_PORT=
BAUD_RATE=115200
DEVICE_TIMEOUT=10
APP_PORT=5000

# 没有连接 STM32 时可改为 true，用模拟帧测试上位机页面
MOCK_SERIAL=false
HISTORY_MAX=120
RAW_LOG_MAX=80

# ==================== AI 配置 ====================
# OpenAI 兼容格式，支持 DeepSeek / 智谱 / 通义 / OpenAI 等
# 留空则使用本地规则兜底（不影响基本功能）
AI_API_BASE=https://api.deepseek.com
AI_API_KEY=
AI_MODEL=deepseek-chat

# ==================== 语音配置（火山引擎） ====================
# 留空则禁用语音输出
TTS_API_KEY=
TTS_VOICE_TYPE=BV405_streaming
TTS_ENABLED=false
